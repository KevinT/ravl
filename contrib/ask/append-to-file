#!/usr/bin/env python3
"""Example ask command: append each question to one text file.

Configure it in a settings file:

    [ask]
    command = ["/path/to/contrib/ask/append-to-file", "/path/to/questions.txt"]

ravl runs it once for each waiting question, with one JSON object on standard input
(see `src/ravl/ask.py`). Exit status 0 tells ravl the question was sent. A command that
carries questions to a chat or to e-mail has the same form: read the object, send
`title` and `text`, keep `answer_with` so the reply can be recorded, exit 0.
"""
import json
import shlex
import sys

if len(sys.argv) != 2:
    sys.exit("usage: append-to-file FILE")
question = json.load(sys.stdin)
with open(sys.argv[1], "a") as out:
    out.write(f"{question['asked']}  {question['title']}  ({question['id']})\n"
              f"  {question['text']}\n"
              f"  answer with: {shlex.join(question['answer_with'])} \"...\"\n\n")

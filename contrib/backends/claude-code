#!/usr/bin/env python3
"""ravl LLM backend: Claude Code in print mode.

An adapter between ravl's LLM contract and one agent CLI. It is not part of the
core, which has no knowledge of any agent runtime. It reads the prompt on stdin,
runs `claude -p`, and writes ravl's envelope on stdout:

    {"text": "...", "usage": {"model": ..., "input_tokens": ..., "output_tokens": ..., "cost_usd": ...}}

Configure it in ~/.config/ravl/config.toml:

    [llm]
    command = ["/path/to/claude-code"]

Arguments given to this script are passed to `claude` in every phase. Arguments
after a `--act` marker are passed only in the Act phase, which is where an agent
needs tools and permission to use them, for example:

    command = ["/path/to/claude-code", "--model", "sonnet",
               "--act", "--permission-mode", "bypassPermissions"]

In the Learn and code-generation phases the model is given no tools: those
phases produce text and change nothing.
"""

import json
import os
import subprocess
import sys


def main() -> int:
    args = sys.argv[1:]
    common, act_only = (args[:args.index("--act")], args[args.index("--act") + 1:]) if "--act" in args else (args, [])
    phase = os.environ.get("RAVL_PHASE", "act")
    command = ["claude", "-p", "--output-format", "json", "--no-session-persistence", *common]
    command += act_only if phase == "act" else ["--tools", ""]
    proc = subprocess.run(command, stdin=sys.stdin, capture_output=True, text=True)
    try:
        reply = json.loads(proc.stdout)
    except json.JSONDecodeError:
        sys.stderr.write((proc.stderr or proc.stdout)[-2000:])
        return proc.returncode or 1
    usage = {"model": "unknown", "input_tokens": 0, "output_tokens": 0,
             "cost_usd": reply.get("total_cost_usd", 0)}
    models = reply.get("modelUsage") or {}
    if models:
        usage["model"] = "+".join(sorted(models))
        for figures in models.values():
            usage["input_tokens"] += (figures.get("inputTokens", 0) + figures.get("cacheReadInputTokens", 0)
                                      + figures.get("cacheCreationInputTokens", 0))
            usage["output_tokens"] += figures.get("outputTokens", 0)
    print(json.dumps({"text": reply.get("result") or "", "usage": usage}))
    if reply.get("is_error") or proc.returncode != 0:
        sys.stderr.write(f"claude: {reply.get('subtype')} {reply.get('api_error_status') or ''}\n")
        return proc.returncode or 1
    return 0


if __name__ == "__main__":
    sys.exit(main())

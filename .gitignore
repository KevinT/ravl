# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
build/

# Local secrets and environment
.env
.env.*
!.env.example

# Loop run artefacts and learnings from actual use never enter the repo.
# Worked examples under examples/ are invented and public; their runs and
# learnings are committed so the learning behaviour is visible in the repo.
**/runs/
**/learnings/
!examples/**/runs/
!examples/**/learnings/

